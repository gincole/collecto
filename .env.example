# Public Supabase configuration from the project's Connect panel.
# These values are intentionally blank. Copy this file to .env.local and fill it locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin used for safe redirects and absolute URLs.
# Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Server-only key for protected administrative seed/reset or cleanup workflows.
# Do not prefix with NEXT_PUBLIC_. Do not expose it to browser-reachable modules.
# Configure only when an approved server workflow requires it.
SUPABASE_SECRET_KEY=

# Server-only bearer secret for the protected storage-cleanup retry endpoint.
# Use a long random value in local/deployed secret stores; never expose it publicly.
STORAGE_CLEANUP_SECRET=

# Shared demo account identifier. The password must never be stored in this file.
DEMO_USER_EMAIL=test@gmail.com

# Admin CLI only: copy the demo user's UUID from Supabase Auth > Users.
# Seed/reset verifies both ID and email; no demo password is needed.
DEMO_USER_ID=
