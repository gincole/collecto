    "test:security:sessions": "node supabase/tests/security_sessions.mjs",
    "test:database": "node supabase/tests/database.mjs",
    "demo:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/demo.mjs",
    "test:demo": "node supabase/tests/demo_seed.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
